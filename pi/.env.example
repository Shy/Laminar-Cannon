# Detection Server Configuration
# Replace with your Flask server's IP address and port
DETECTION_SERVER_URL=http://192.168.1.100:5001/detect-person

# Servo Configuration
# Adjust these during calibration (use calibrate.py)
SERVO_X_CENTER=135
SERVO_Y_CENTER=100
SERVO_X_INVERT=false
SERVO_Y_INVERT=false

# Fan Control
# Fan speed as percentage (0-100)
FAN_SPEED=80

# Seconds to keep fan running after last face detection
FACE_DETECTION_TIMEOUT=5
